<!DOCTYPE html>
<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VersaServe Catering</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Mulish:wght@300;400;600&display=swap">
<style>
:root{--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#9c2f4b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#9c2f4b}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#e58aa0}}
:root[data-theme="dark"]{--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#e58aa0}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:300 17px/1.65 Mulish,system-ui,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#fffffff2;z-index:30}
h1,h2,h3{font-family:Jost,system-ui,sans-serif;font-weight:300;line-height:1.15;margin:0}
h2{font-size:clamp(28px,4vw,42px);letter-spacing:.04em}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:6px clamp(16px,4vw,48px);background:#fffffff2;backdrop-filter:blur(8px);color:#0f2238;border-bottom:1px solid #d7dee7}
.logo{font:500 20px Jost,sans-serif;letter-spacing:.08em;text-decoration:none}
.logo span{color:#c2a165;font-weight:300}
nav{display:flex;gap:clamp(12px,2vw,28px);overflow-x:auto;font-size:14px;letter-spacing:.06em}
nav a{text-decoration:none;white-space:nowrap;padding:4px 0}
nav a:hover{color:var(--gold)}
.btn{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:12px 26px;text-decoration:none;font:400 14px Jost,sans-serif;letter-spacing:.1em;background:none;cursor:pointer}
.btn:hover{background:var(--gold);color:var(--ink)}
.hero{position:relative;min-height:88vh;display:grid;align-items:end;background:#0f2238 center/cover no-repeat url(data:image/jpeg;base64,);color:#fff}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0f223855,#0f2238e0 90%)}
.hero div{position:relative;padding:0 clamp(20px,6vw,80px) clamp(48px,9vh,96px);max-width:900px}
.hero h1{font-size:clamp(36px,6.4vw,76px);letter-spacing:.02em;margin-bottom:18px}
.hero p{max-width:520px;margin:0 0 28px;color:#e3eaf2}
section{padding:clamp(56px,9vw,112px) clamp(20px,6vw,80px)}
.wrap{max-width:1080px;margin:0 auto}
.head{text-align:center;margin-bottom:52px}
.head p{color:var(--mut);max-width:560px;margin:14px auto 0}
.icons{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:36px;text-align:center}
.icons svg{width:46px;height:46px;stroke:var(--gold);fill:none;stroke-width:1.2;margin-bottom:12px}
.icons h3{font-size:16px;letter-spacing:.08em;margin-bottom:6px}
.icons p{margin:0;font-size:15px;color:var(--mut)}
.alt{background:var(--bg2)}
.tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 28px;margin-bottom:40px;border-bottom:1px solid var(--line)}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--mut);font:400 15px Jost,sans-serif;letter-spacing:.08em;padding:12px 0;cursor:pointer}
.tabs button[aria-selected="true"]{color:var(--gold);border-color:var(--gold)}
.panel{display:none;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.panel.on{display:grid}
.panel img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.row{display:flex;align-items:baseline;gap:12px;padding:14px 0}
.row i{flex:1;border-bottom:1px solid var(--line);transform:translateY(-4px)}
.row b{font:400 19px Jost,sans-serif}
.row small{display:block;color:var(--mut);font-size:14px}
.row em{font:400 19px Jost,sans-serif;font-style:normal;color:var(--gold);white-space:nowrap}
.note{font-size:14px;color:var(--mut);margin-top:12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pair img{width:100%;height:100%;min-height:280px;object-fit:cover;display:block}
.steps{list-style:none;padding:0;margin:28px 0 0;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;padding:14px 0;border-top:1px solid var(--line)}
.steps li::before{content:counter(s);font:300 26px Jost,sans-serif;color:var(--gold)}
.steps b{font:500 16px Jost,sans-serif;letter-spacing:.04em}
.steps span{display:block;color:var(--mut);font-size:15px}
form{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:760px;margin:0 auto}
form .f{grid-column:1/-1}
label{display:grid;gap:6px;font-size:14px;color:var(--mut)}
input,select,textarea{font:inherit;color:var(--tx);background:transparent;border:1px solid var(--line);padding:12px;border-radius:0;width:100%}
select option{color:#222}
.out{grid-column:1/-1;font-size:15px;color:var(--mut)}
footer{background:var(--bg2);border-top:1px solid var(--line);padding:48px clamp(20px,6vw,80px);font-size:14px;color:var(--mut)}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px}
footer h3{font-size:15px;color:var(--tx);letter-spacing:.08em;margin-bottom:8px}
.hero .btn{border-color:#fff;color:#fff}.hero .btn:hover{background:#fff;color:#0f2238}.icons div:nth-child(1) svg{stroke:var(--grn)}#t0[aria-selected="true"]{color:var(--grn);border-color:var(--grn)}#p0 .row em{color:var(--grn)}footer{border-top:3px solid var(--grn)}
@media (max-width:760px){.panel.on,.split,form{grid-template-columns:1fr}.pair img{min-height:200px}header{flex-wrap:wrap}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header>
<a class="logo" href="#top" aria-label="VersaServe Catering home"><img src="data:image/png;base64," alt="VersaServe Catering" style="height:64px;width:auto;display:block"></a>
<nav aria-label="Main"><a href="#services">Services</a><a href="#menu">Menu</a><a href="#how">How it works</a><a href="#quote">Request a quote</a></nav>
</header>

<main id="top">
<div class="hero" role="img" aria-label="Chafing-dish buffet set up beside a boardroom">
<div>
<h1>Good food for the meeting room, delivered on time</h1>
<p>Packed lunches, meeting refreshments and platters for offices, training providers and institutions. Order ahead, confirm your headcount, and we handle the rest.</p>
<a class="btn" href="#quote">Request a quote</a>
</div>
</div>

<section id="services"><div class="wrap">
<div class="head"><h2>What we cater</h2><p>Pre-ordered catering for work days. Prepared by vetted catering partners and coordinated by one point of contact.</p></div>
<div class="icons">
<div><svg viewBox="0 0 48 48"><rect x="6" y="14" width="36" height="22" rx="3"/><path d="M6 25h36M24 14v22"/></svg><h3>Packed lunches</h3><p>Sealed, labelled meals per person.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M10 18h24v12a8 8 0 0 1-8 8h-8a8 8 0 0 1-8-8zM34 21h4a4 4 0 0 1 0 8h-4M18 8v5M26 8v5"/></svg><h3>Meeting refreshments</h3><p>Coffee, tea, water and pastries.</p></div>
<div><svg viewBox="0 0 48 48"><ellipse cx="24" cy="30" rx="18" ry="7"/><path d="M12 28c0-8 5-13 12-13s12 5 12 13"/></svg><h3>Snack platters</h3><p>Finger food and desserts for events.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M6 34h36M10 34c0-9 6-15 14-15s14 6 14 15M24 14v5"/></svg><h3>Hot buffets</h3><p>Larger functions, quoted on request.</p></div>
</div>
</div></section>

<section id="menu" class="alt"><div class="wrap">
<div class="head"><h2>Menu and pricing</h2></div>
<div class="tabs" role="tablist">
<button role="tab" aria-selected="true" aria-controls="p0" id="t0">Packed lunches</button>
<button role="tab" aria-selected="false" aria-controls="p1" id="t1">Meetings and training</button>
<button role="tab" aria-selected="false" aria-controls="p2" id="t2">Platters</button>
<button role="tab" aria-selected="false" aria-controls="p3" id="t3">Buffets</button>
</div>

<div class="panel on" id="p0" role="tabpanel" aria-labelledby="t0">
<img src="data:image/jpeg;base64," alt="Meal boxes with rice, glazed chicken and broccoli" loading="lazy">
<div>
<div class="row"><div><b>Standard packed lunch</b><small>Protein, starch and vegetables, per meal</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Vegetarian lunch</b><small>Per meal</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Weekly lunch plan</b><small>Recurring weekday orders</small></div><i></i><em>Quoted</em></div>
<p class="note">Prices exclude VAT and delivery and are confirmed on your written quotation.</p>
</div></div>

<div class="panel" id="p1" role="tabpanel" aria-labelledby="t1">
<img src="data:image/jpeg;base64," alt="Pastries, cups and napkins on a meeting-room table" loading="lazy">
<div>
<div class="row"><div><b>Morning refreshments</b><small>Pastries, coffee and tea, per person</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Coffee, decaf and hot water</b><small>Flask station with cups and sugar</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Water and stationery set-up</b><small>For classroom or boardroom layouts</small></div><i></i><em>Quoted</em></div>
<p class="note">Tell us your headcount and start time and we’ll price the full day.</p>
</div></div>

<div class="panel" id="p2" role="tabpanel" aria-labelledby="t2">
<img src="data:image/jpeg;base64," alt="Mini dessert cups topped with lime zest" loading="lazy">
<div>
<div class="row"><div><b>Snack platter</b><small>Per platter or per person</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Dessert cups</b><small>Individually served, per person</small></div><i></i><em>Quoted</em></div>
<p class="note">Please list allergies when you order. We pass them to the kitchen in writing.</p>
</div></div>

<div class="panel" id="p3" role="tabpanel" aria-labelledby="t3">
<img src="data:image/jpeg;base64," alt="Glazed chicken and stew in chafing dishes" loading="lazy">
<div>
<div class="row"><div><b>Hot buffet</b><small>Mains, sides and serving equipment, per guest</small></div><i></i><em>Quoted</em></div>
<div class="row"><div><b>Function catering</b><small>Menu, staff and set-up as needed</small></div><i></i><em>Quoted</em></div>
<p class="note">Buffets need equipment and on-site set-up, so we plan these with extra lead time.</p>
</div></div>
</div></section>

<section><div class="wrap split">
<div class="pair"><img src="data:image/jpeg;base64," alt="Classroom layout with water bottles and notepads" loading="lazy"><img src="data:image/jpeg;base64," alt="Coffee, decaf and hot water flasks" loading="lazy"></div>
<div>
<h2>Set up for the room</h2>
<p style="color:var(--mut)">Training day or board meeting, the table is ready before your guests arrive: water, notepads, refreshment stations and food timed to your agenda.</p>
</div>
</div></section>

<section id="how" class="alt"><div class="wrap split">
<div><h2>How ordering works</h2>
<ol class="steps">
<li><div><b>Tell us the details</b><span>Headcount, date, location, budget and dietary needs.</span></div></li>
<li><div><b>Get a written quote</b><span>Food, packaging and delivery in one price.</span></div></li>
<li><div><b>Confirm and pay a deposit</b><span>Larger orders are secured with a deposit.</span></div></li>
<li><div><b>Final numbers by the cutoff</b><span>We agree the cutoff when you accept the quote.</span></div></li>
<li><div><b>We deliver and invoice</b><span>You sign for delivery and receive your invoice.</span></div></li>
</ol></div>
<img src="data:image/jpeg;base64," alt="Row of chafing dishes with mixed dishes" style="width:100%;aspect-ratio:4/5;object-fit:cover" loading="lazy">
</div></section>

<section id="quote"><div class="wrap">
<div class="head"><h2>Request a quote</h2><p>Fill in what you know. Your email app opens with the request ready to send.</p></div>
<form id="qf">
<label>Name<input name="n" required autocomplete="name"></label>
<label>Organisation<input name="o" autocomplete="organization"></label>
<label>Event date<input name="d" type="date" required></label>
<label>Number of people<input name="h" type="number" min="1" required></label>
<label class="f">What do you need?<select name="t"><option>Packed lunches</option><option>Meeting refreshments</option><option>Snack platters</option><option>Hot buffet</option><option>Not sure yet</option></select></label>
<label class="f">Delivery address and dietary needs<textarea name="x" rows="3"></textarea></label>
<div class="f"><button class="btn" type="submit">Prepare my request</button></div>
<p class="out" id="out" role="status"></p>
</form>
</div></section>
</main>

<footer><div class="wrap"><div><picture><source media="(prefers-color-scheme: dark)" srcset="data:image/png;base64,"><img src="data:image/png;base64," alt="VersaServe Catering" style="height:110px;width:auto;display:block"></picture></div>
<div><h3>VersaServe Catering</h3>A division of VersaServe Industries<br>Registration K2023169707, South Africa</div>
<div><h3>Sections</h3><a href="#services">Services</a> · <a href="#menu">Menu</a> · <a href="#how">How it works</a></div>
<div style="max-width:320px"><h3>Good to know</h3>Prices are indicative and exclude VAT where applicable. Food is prepared by vetted catering partners.</div>
</div></footer>

<script>
var tabs=[].slice.call(document.querySelectorAll('[role=tab]'));
tabs.forEach(function(t,i){t.addEventListener('click',function(){
tabs.forEach(function(b,j){b.setAttribute('aria-selected',i===j);document.getElementById('p'+j).classList.toggle('on',i===j)})})});
document.getElementById('qf').addEventListener('submit',function(e){
e.preventDefault();var f=e.target,v=function(k){return f.elements[k].value};
var body='Name: '+v('n')+'\nOrganisation: '+v('o')+'\nDate: '+v('d')+'\nPeople: '+v('h')+'\nNeed: '+v('t')+'\nDetails: '+v('x');
location.href='mailto:?subject='+encodeURIComponent('Catering quote request')+'&body='+encodeURIComponent(body);
document.getElementById('out').textContent='Your email app should open. If it doesn’t, copy these details and send them to us directly.'});
</script>
</body>
</html>
