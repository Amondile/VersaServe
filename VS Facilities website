<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VersaServe Facilities</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Mulish:wght@300;400;600&display=swap">
<style>
:root{--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#2f8a57;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#2f8a57}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#5fc08a}}
:root[data-theme="dark"]{--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#5fc08a}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:300 17px/1.65 Mulish,system-ui,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#fffffff2;z-index:30}
h1,h2,h3{font-family:Jost,system-ui,sans-serif;font-weight:300;line-height:1.15;margin:0}
h2{font-size:clamp(28px,4vw,42px);letter-spacing:.04em}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:6px clamp(16px,4vw,48px);background:#fffffff2;backdrop-filter:blur(8px);color:#0f2238;border-bottom:1px solid #d7dee7}
.logo{font:500 20px Jost,sans-serif;letter-spacing:.08em;text-decoration:none}
.logo span{color:#7ec29a;font-weight:300}
nav{display:flex;gap:clamp(12px,2vw,28px);overflow-x:auto;font-size:14px;letter-spacing:.06em}
nav a{text-decoration:none;white-space:nowrap;padding:4px 0}
nav a:hover{color:var(--gold)}
.btn{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:12px 26px;text-decoration:none;font:400 14px Jost,sans-serif;letter-spacing:.1em;background:none;cursor:pointer}
.btn:hover{background:var(--gold);color:var(--ink)}
.hero{position:relative;min-height:88vh;display:grid;align-items:end;background:#0f2238 center/cover no-repeat url(data:image/jpeg;base64,);color:#fff}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0f223855,#0f2238e0 90%)}
.hero div{position:relative;padding:0 clamp(20px,6vw,80px) clamp(48px,9vh,96px);max-width:900px}
.hero h1{font-size:clamp(36px,6.4vw,76px);letter-spacing:.02em;margin-bottom:18px}
.hero p{max-width:520px;margin:0 0 28px;color:#e3eaf2}
section{padding:clamp(56px,9vw,112px) clamp(20px,6vw,80px)}
.wrap{max-width:1080px;margin:0 auto}
.head{text-align:center;margin-bottom:52px}
.head p{color:var(--mut);max-width:560px;margin:14px auto 0}
.icons{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:36px;text-align:center}
.icons svg{width:46px;height:46px;stroke:var(--gold);fill:none;stroke-width:1.2;margin-bottom:12px}
.icons h3{font-size:16px;letter-spacing:.08em;margin-bottom:6px}
.icons p{margin:0;font-size:15px;color:var(--mut)}
.alt{background:var(--bg2)}
.tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 28px;margin-bottom:40px;border-bottom:1px solid var(--line)}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--mut);font:400 15px Jost,sans-serif;letter-spacing:.08em;padding:12px 0;cursor:pointer}
.tabs button[aria-selected="true"]{color:var(--gold);border-color:var(--gold)}
.panel{display:none;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.panel.on{display:grid}
.panel img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.row{display:flex;align-items:baseline;gap:12px;padding:14px 0}
.row i{flex:1;border-bottom:1px solid var(--line);transform:translateY(-4px)}
.row b{font:400 19px Jost,sans-serif}
.row small{display:block;color:var(--mut);font-size:14px}
.row em{font:400 19px Jost,sans-serif;font-style:normal;color:var(--gold);white-space:nowrap}
.note{font-size:14px;color:var(--mut);margin-top:12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pair img{width:100%;height:100%;min-height:280px;object-fit:cover;display:block}
.steps{list-style:none;padding:0;margin:28px 0 0;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;padding:14px 0;border-top:1px solid var(--line)}
.steps li::before{content:counter(s);font:300 26px Jost,sans-serif;color:var(--gold)}
.steps b{font:500 16px Jost,sans-serif;letter-spacing:.04em}
.steps span{display:block;color:var(--mut);font-size:15px}
form{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:760px;margin:0 auto}
form .f{grid-column:1/-1}
label{display:grid;gap:6px;font-size:14px;color:var(--mut)}
input,select,textarea{font:inherit;color:var(--tx);background:transparent;border:1px solid var(--line);padding:12px;border-radius:0;width:100%}
select option{color:#222}
.out{grid-column:1/-1;font-size:15px;color:var(--mut)}
footer{background:var(--bg2);border-top:1px solid var(--line);padding:48px clamp(20px,6vw,80px);font-size:14px;color:var(--mut)}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px}
footer h3{font-size:15px;color:var(--tx);letter-spacing:.08em;margin-bottom:8px}
.hero .btn{border-color:#fff;color:#fff}.hero .btn:hover{background:#fff;color:#0f2238}.icons div:nth-child(4) svg{stroke:var(--grn)}#t3[aria-selected="true"]{color:var(--grn);border-color:var(--grn)}#p3 .row em{color:var(--grn)}footer{border-top:3px solid var(--grn)}
@media (max-width:760px){.panel.on,.split,form{grid-template-columns:1fr}.pair img{min-height:200px}header{flex-wrap:wrap}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header>
<a class="logo" href="#top" aria-label="VersaServe Facilities home"><img src="data:image/png;base64," alt="VersaServe Facilities" style="height:64px;width:auto;display:block"></a>
<nav aria-label="Main"><a href="#services">Services</a><a href="#rates">Pricing</a><a href="#how">How it works</a><a href="#quote">Book a site visit</a></nav>
</header>

<main id="top">
<div class="hero" role="img" aria-label="Cleaners disinfecting an office"><div>
<h1>Clean premises, with the work documented</h1>
<p>Commercial cleaning, post-construction clean-ups and grounds care for offices, property managers and contractors. A written scope, a site checklist and one point of contact.</p>
<a class="btn" href="#quote">Book a site visit</a></div></div>

<section id="services"><div class="wrap">
<div class="head"><h2>What we maintain</h2><p>We start small and do it properly: defined sites, clear scopes and sign-off after every visit.</p></div>
<div class="icons">
<div><svg viewBox="0 0 48 48"><rect x="12" y="6" width="24" height="36"/><path d="M18 14h4M26 14h4M18 22h4M26 22h4M21 42v-8h6v8"/></svg><h3>Office cleaning</h3><p>Scheduled cleaning for commercial premises.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M16 20h14v20H16zM20 20v-6h6M26 14h8l-3-4"/></svg><h3>Deep cleaning</h3><p>Once-off, move-in and move-out jobs.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M8 40l14-14M20 22l8 8M28 14l6-6 6 6-6 6z"/></svg><h3>Post-construction</h3><p>Dust and debris cleared before handover.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M24 42V22M24 28c-8 0-12-6-12-14 8 0 12 6 12 14zM24 24c6 0 10-5 10-12-6 0-10 5-10 12z"/></svg><h3>Grounds care</h3><p>Lawns, hedges and outdoor areas.</p></div>
</div></div></section>

<section id="rates" class="alt"><div class="wrap">
<div class="head"><h2>Services and pricing</h2><p>Each price is built from the hours, staffing and materials your site needs, so we quote after a visit.</p></div>
<div class="tabs" role="tablist">
<button role="tab" aria-selected="true" aria-controls="p0" id="t0">Office cleaning</button>
<button role="tab" aria-selected="false" aria-controls="p1" id="t1">Deep cleaning</button>
<button role="tab" aria-selected="false" aria-controls="p2" id="t2">Post-construction</button>
<button role="tab" aria-selected="false" aria-controls="p3" id="t3">Grounds</button></div>
<div class="panel on" id="p0" role="tabpanel" aria-labelledby="t0"><img src="data:image/jpeg;base64," alt="Cleaner mopping a corridor beside a cleaning trolley" loading="lazy"><div><div class="row"><div><b>Routine office cleaning</b><small>Monthly fee based on hours, frequency and supervision</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Consumables and hygiene top-ups</b><small>Added to the monthly fee when you want us to supply them</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Relief and overflow cover</b><small>For established cleaning and facilities firms</small></div><i></i><em>Quoted</em></div><p class="note">Every recurring contract starts with a site assessment.</p></div></div><div class="panel" id="p1" role="tabpanel" aria-labelledby="t1"><img src="data:image/jpeg;base64," alt="Cleaner in a mask and gloves spraying a marble counter" loading="lazy"><div><div class="row"><div><b>Once-off deep clean</b><small>Per site or area, after inspection</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Move-in and move-out cleaning</b><small>By property size, condition and turnaround</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Sanitising of high-touch surfaces</b><small>Rails, counters, handles and shared areas</small></div><i></i><em>Quoted</em></div><p class="note">We agree the products and surfaces with you before we start.</p></div></div><div class="panel" id="p2" role="tabpanel" aria-labelledby="t2"><img src="data:image/jpeg;base64," alt="Worker sweeping rubble from a renovated room" loading="lazy"><div><div class="row"><div><b>Post-construction cleaning</b><small>Dust, debris and finishes, after we inspect the site</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Builder’s clean before handover</b><small>Priced per area and scope</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Rubble and waste removal</b><small>Quoted with the clean or separately</small></div><i></i><em>Quoted</em></div><p class="note">Tell us the handover date and we’ll plan backwards from it.</p></div></div><div class="panel" id="p3" role="tabpanel" aria-labelledby="t3"><img src="data:image/jpeg;base64," alt="Two grounds workers trimming grass edges along a path" loading="lazy"><div><div class="row"><div><b>Grounds maintenance</b><small>Per visit or monthly schedule, by area and equipment</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Hedge and shrub trimming</b><small>Per visit</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Lawn mowing and edging</b><small>Per visit or monthly schedule</small></div><i></i><em>Quoted</em></div><p class="note">Send us a site photo with your enquiry to speed up the quote.</p></div></div>
</div></section>

<section><div class="wrap split">
<div class="pair"><img src="data:image/jpeg;base64," alt="Cleaner in protective clothing wiping a laboratory counter" loading="lazy"><img src="data:image/jpeg;base64," alt="Gloved hand carrying a bucket of cloths and a squeegee" loading="lazy"></div>
<div><h2>A scope you can check</h2>
<p style="color:var(--mut)">Your written scope lists the areas covered, how often we visit, the hours on site, who supplies consumables and equipment, what is excluded and how quickly we respond. We plan protective gear and chemicals for each site, and we record anything that changes.</p></div>
</div></section>

<section id="how" class="alt"><div class="wrap split">
<div><h2>How it works</h2>
<ol class="steps">
<li><div><b>Site visit</b><span>We walk the premises and note areas, access and condition.</span></div></li>
<li><div><b>Written scope and quote</b><span>Hours, frequency, materials and exclusions in one document.</span></div></li>
<li><div><b>Agree the schedule</b><span>Start date, visit times and who we report to.</span></div></li>
<li><div><b>Service with sign-off</b><span>A checklist is completed and signed after each visit.</span></div></li>
<li><div><b>Issues logged, then invoiced</b><span>Damage, access problems and scope changes are recorded and agreed in writing.</span></div></li>
</ol></div>
<img src="data:image/jpeg;base64," alt="Cleaner spraying a surface in a bright office" style="width:100%;aspect-ratio:4/5;object-fit:cover" loading="lazy">
</div></section>

<section id="quote"><div class="wrap">
<div class="head"><h2>Book a site visit</h2><p>Tell us about the premises. Your email app opens with the request ready to send.</p></div>
<form id="qf">
<label>Name<input name="n" required autocomplete="name"></label>
<label>Organisation<input name="o" autocomplete="organization"></label>
<label>Preferred visit date<input name="d" type="date" required></label>
<label>Approximate size (m²)<input name="h" type="number" min="1"></label>
<label class="f">What do you need?<select name="t"><option>Office cleaning</option><option>Deep cleaning</option><option>Post-construction cleaning</option><option>Grounds maintenance</option><option>Not sure yet</option></select></label>
<label class="f">Site address and anything we should know<textarea name="x" rows="3"></textarea></label>
<div class="f"><button class="btn" type="submit">Prepare my request</button></div>
<p class="out" id="out" role="status"></p>
</form></div></section>
</main>

<footer><div class="wrap"><div><picture><source media="(prefers-color-scheme: dark)" srcset="data:image/png;base64,"><img src="data:image/png;base64," alt="VersaServe Facilities" style="height:110px;width:auto;display:block"></picture></div>
<div><h3>VersaServe Facilities</h3>A division of VersaServe Industries<br>Registration K2023169707, South Africa</div>
<div><h3>Sections</h3><a href="#services">Services</a> · <a href="#rates">Pricing</a> · <a href="#how">How it works</a></div>
<div style="max-width:320px"><h3>Good to know</h3>Quotations are based on a site visit and a written scope of work. Prices exclude VAT where applicable.</div>
</div></footer>

<script>
var tabs=[].slice.call(document.querySelectorAll('[role=tab]'));
tabs.forEach(function(t,i){t.addEventListener('click',function(){
tabs.forEach(function(b,j){b.setAttribute('aria-selected',i===j);document.getElementById('p'+j).classList.toggle('on',i===j)})})});
document.getElementById('qf').addEventListener('submit',function(e){
e.preventDefault();var f=e.target,v=function(k){return f.elements[k].value};
var body='Name: '+v('n')+'\nOrganisation: '+v('o')+'\nVisit date: '+v('d')+'\nSize m2: '+v('h')+'\nNeed: '+v('t')+'\nDetails: '+v('x');
location.href='mailto:?subject='+encodeURIComponent('Site visit request')+'&body='+encodeURIComponent(body);
document.getElementById('out').textContent='Your email app should open. If it doesn’t, copy these details and send them to us directly.'});
</script>
</body>
</html>

