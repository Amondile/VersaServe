<!DOCTYPE html>
<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VersaServe Supply</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Mulish:wght@300;400;600&display=swap">
<style>
:root{--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#b86e00;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f5f7fa;--bg2:#e8edf3;--tx:#1b2a3c;--mut:#566779;--gold:#1f4e79;--line:#cdd6e0;--ink:#fff;--grn:#b86e00}}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#f0b44c}}
:root[data-theme="dark"]{--bg:#0f1a28;--bg2:#0b131e;--tx:#e6edf5;--mut:#9fb0c2;--gold:#7db3e3;--line:#243449;--ink:#0b131e;--grn:#f0b44c}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:300 17px/1.65 Mulish,system-ui,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#fffffff2;z-index:30}
h1,h2,h3{font-family:Jost,system-ui,sans-serif;font-weight:300;line-height:1.15;margin:0}
h2{font-size:clamp(28px,4vw,42px);letter-spacing:.04em}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:6px clamp(16px,4vw,48px);background:#fffffff2;backdrop-filter:blur(8px);color:#0f2238;border-bottom:1px solid #d7dee7}
.logo{font:500 20px Jost,sans-serif;letter-spacing:.08em;text-decoration:none}
.logo span{color:#f0b44c;font-weight:300}
nav{display:flex;gap:clamp(12px,2vw,28px);overflow-x:auto;font-size:14px;letter-spacing:.06em}
nav a{text-decoration:none;white-space:nowrap;padding:4px 0}
nav a:hover{color:var(--gold)}
.btn{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:12px 26px;text-decoration:none;font:400 14px Jost,sans-serif;letter-spacing:.1em;background:none;cursor:pointer}
.btn:hover{background:var(--gold);color:var(--ink)}
.hero{position:relative;min-height:88vh;display:grid;align-items:end;background:#0f2238 center/cover no-repeat url(data:image/jpeg;base64,);color:#fff}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0f223855,#0f2238e0 90%)}
.hero div{position:relative;padding:0 clamp(20px,6vw,80px) clamp(48px,9vh,96px);max-width:900px}
.hero h1{font-size:clamp(36px,6.4vw,76px);letter-spacing:.02em;margin-bottom:18px}
.hero p{max-width:520px;margin:0 0 28px;color:#e3eaf2}
section{padding:clamp(56px,9vw,112px) clamp(20px,6vw,80px)}
.wrap{max-width:1080px;margin:0 auto}
.head{text-align:center;margin-bottom:52px}
.head p{color:var(--mut);max-width:560px;margin:14px auto 0}
.icons{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:36px;text-align:center}
.icons svg{width:46px;height:46px;stroke:var(--gold);fill:none;stroke-width:1.2;margin-bottom:12px}
.icons h3{font-size:16px;letter-spacing:.08em;margin-bottom:6px}
.icons p{margin:0;font-size:15px;color:var(--mut)}
.alt{background:var(--bg2)}
.tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 28px;margin-bottom:40px;border-bottom:1px solid var(--line)}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--mut);font:400 15px Jost,sans-serif;letter-spacing:.08em;padding:12px 0;cursor:pointer}
.tabs button[aria-selected="true"]{color:var(--gold);border-color:var(--gold)}
.panel{display:none;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.panel.on{display:grid}
.panel img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.row{display:flex;align-items:baseline;gap:12px;padding:14px 0}
.row i{flex:1;border-bottom:1px solid var(--line);transform:translateY(-4px)}
.row b{font:400 19px Jost,sans-serif}
.row small{display:block;color:var(--mut);font-size:14px}
.row em{font:400 19px Jost,sans-serif;font-style:normal;color:var(--gold);white-space:nowrap}
.note{font-size:14px;color:var(--mut);margin-top:12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pair img{width:100%;height:100%;min-height:280px;object-fit:cover;display:block}
.steps{list-style:none;padding:0;margin:28px 0 0;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;padding:14px 0;border-top:1px solid var(--line)}
.steps li::before{content:counter(s);font:300 26px Jost,sans-serif;color:var(--gold)}
.steps b{font:500 16px Jost,sans-serif;letter-spacing:.04em}
.steps span{display:block;color:var(--mut);font-size:15px}
form{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:760px;margin:0 auto}
form .f{grid-column:1/-1}
label{display:grid;gap:6px;font-size:14px;color:var(--mut)}
input,select,textarea{font:inherit;color:var(--tx);background:transparent;border:1px solid var(--line);padding:12px;border-radius:0;width:100%}
select option{color:#222}
.out{grid-column:1/-1;font-size:15px;color:var(--mut)}
footer{background:var(--bg2);border-top:1px solid var(--line);padding:48px clamp(20px,6vw,80px);font-size:14px;color:var(--mut)}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px}
footer h3{font-size:15px;color:var(--tx);letter-spacing:.08em;margin-bottom:8px}
.hero .btn{border-color:#fff;color:#fff}.hero .btn:hover{background:#fff;color:#0f2238}.panel img.prod,.pair img.prod{object-fit:contain;background:#fff}.icons div:nth-child(1) svg{stroke:var(--grn)}#t0[aria-selected="true"]{color:var(--grn);border-color:var(--grn)}#p0 .row em{color:var(--grn)}footer{border-top:3px solid var(--grn)}
@media (max-width:760px){.panel.on,.split,form{grid-template-columns:1fr}.pair img{min-height:200px}header{flex-wrap:wrap}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header>
<a class="logo" href="#top" aria-label="VersaServe Supply home"><img src="data:image/png;base64," alt="VersaServe Supply" style="height:64px;width:auto;display:block"></a>
<nav aria-label="Main"><a href="#services">Products</a><a href="#rates">Pricing</a><a href="#how">How it works</a><a href="#quote">Request a quote</a></nav>
</header>

<main id="top">
<div class="hero" role="img" aria-label="Safety boots, helmet, goggles, gloves and respirator"><div>
<h1>Everyday supplies for sites and offices, quoted clearly</h1>
<p>PPE, workwear, cleaning and hygiene products, stationery and packaging for contractors, offices and institutions. Send your list and get a written quotation with delivery included.</p>
<a class="btn" href="#quote">Request a quote</a></div></div>

<section id="services"><div class="wrap">
<div class="head"><h2>What we supply</h2><p>A focused catalogue of the things you reorder most, sourced against confirmed orders.</p></div>
<div class="icons">
<div><svg viewBox="0 0 48 48"><path d="M8 30a16 16 0 0 1 32 0zM6 30h36v5H6zM24 14v-5"/></svg><h3>PPE and safety</h3><p>Head, eye, ear, hand and foot protection.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M16 8l-10 7 5 6 5-3v22h16V18l5 3 5-6-10-7c-1 4-4 6-8 6s-7-2-8-6z"/></svg><h3>Workwear</h3><p>Overalls, suits and uniforms.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M24 6c6 9 11 15 11 22a11 11 0 0 1-22 0c0-7 5-13 11-22z"/></svg><h3>Cleaning and hygiene</h3><p>Chemicals, cloths and consumables.</p></div>
<div><svg viewBox="0 0 48 48"><path d="M10 38l4-14 22-16 4 4-16 22zM10 38l6-2"/></svg><h3>Stationery and packaging</h3><p>Office supplies and packing materials.</p></div>
</div></div></section>

<section id="rates" class="alt"><div class="wrap">
<div class="head"><h2>Products and pricing</h2><p>Prices depend on specification, quantity, supplier stock and delivery distance, so each one is quoted.</p></div>
<div class="tabs" role="tablist">
<button role="tab" aria-selected="true" aria-controls="p0" id="t0">PPE</button>
<button role="tab" aria-selected="false" aria-controls="p1" id="t1">Workwear</button>
<button role="tab" aria-selected="false" aria-controls="p2" id="t2">Cleaning and hygiene</button>
<button role="tab" aria-selected="false" aria-controls="p3" id="t3">Stationery and packaging</button></div>
<div class="panel on" id="p0" role="tabpanel" aria-labelledby="t0"><img class="prod" src="data:image/jpeg;base64," alt="Gloves, ear defenders, respirators, safety glasses, helmet and hi-vis vest" loading="lazy"><div><div class="row"><div><b>Head, eye and ear protection</b><small>Hard hats, safety glasses and ear defenders</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Respiratory protection</b><small>Dust masks and half-mask respirators</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Gloves, boots and hi-vis</b><small>Sized to your team and specification</small></div><i></i><em>Quoted</em></div><p class="note">Send us your specification first. We don’t swap a safety item without your written approval.</p></div></div><div class="panel" id="p1" role="tabpanel" aria-labelledby="t1"><img class="prod" src="data:image/jpeg;base64," alt="Grey work coverall shown from the front and back" loading="lazy"><div><div class="row"><div><b>Overalls and two-piece suits</b><small>Per set, in your sizes and colours</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Reflective-trim workwear</b><small>Per garment</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Uniforms and scrubs</b><small>Per garment</small></div><i></i><em>Quoted</em></div><p class="note">Send sizes and quantities and we’ll confirm sizing, colours and lead times.</p></div></div><div class="panel" id="p2" role="tabpanel" aria-labelledby="t2"><img src="data:image/jpeg;base64," alt="Rows of colour-coded cleaning chemical containers" loading="lazy"><div><div class="row"><div><b>Cleaning chemicals</b><small>Per container, with dilution and safety information</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Cloths, mops and buckets</b><small>Per item or per pack</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Hygiene consumables</b><small>Soap, paper and refills for recurring orders</small></div><i></i><em>Quoted</em></div><p class="note">Repeat orders can be scheduled so you never run out.</p></div></div><div class="panel" id="p3" role="tabpanel" aria-labelledby="t3"><img class="prod" src="data:image/jpeg;base64," alt="Stack of spiral-bound notebooks in different colours" loading="lazy"><div><div class="row"><div><b>Paper, notebooks and files</b><small>Per unit or per carton</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Pens and desk items</b><small>Per unit or per pack</small></div><i></i><em>Quoted</em></div><div class="row"><div><b>Packaging and consumables</b><small>Quoted against minimum order quantities</small></div><i></i><em>Quoted</em></div><p class="note">Mixed orders are fine. We consolidate them into one delivery where we can.</p></div></div>
</div></section>

<section><div class="wrap split">
<div class="pair"><img src="data:image/jpeg;base64," alt="Folded scrubs with a stethoscope and white shoes" loading="lazy"><img src="data:image/jpeg;base64," alt="Four spiral-bound notebooks" loading="lazy"></div>
<div><h2>Specified, then checked</h2>
<p style="color:var(--mut)">We confirm the specification and quantity before we quote, compare supplier prices, and inspect goods when they arrive. Where safety standards apply, we ask suppliers for evidence that products meet them.</p></div>
</div></section>

<section id="how" class="alt"><div class="wrap split">
<div><h2>How ordering works</h2>
<ol class="steps">
<li><div><b>Send your list</b><span>Products, sizes, quantities, delivery address and deadline.</span></div></li>
<li><div><b>We compare suppliers</b><span>Real quotations, including transport to you.</span></div></li>
<li><div><b>Written quotation</b><span>One price, with its validity period and payment terms.</span></div></li>
<li><div><b>Confirm with an order</b><span>A purchase order or deposit, depending on the order.</span></div></li>
<li><div><b>Buy, inspect, deliver</b><span>You get proof of delivery and a prompt invoice.</span></div></li>
</ol></div>
<img src="data:image/jpeg;base64," alt="Colour-coded cleaning containers stacked in a storeroom" style="width:100%;aspect-ratio:4/5;object-fit:cover" loading="lazy">
</div></section>

<section id="quote"><div class="wrap">
<div class="head"><h2>Request a quote</h2><p>Add what you can. Your email app opens with the request ready to send.</p></div>
<form id="qf">
<label>Name<input name="n" required autocomplete="name"></label>
<label>Organisation<input name="o" autocomplete="organization"></label>
<label>Delivery needed by<input name="d" type="date" required></label>
<label>Approximate number of items<input name="h" type="number" min="1"></label>
<label class="f">What do you need?<select name="t"><option>PPE and safety</option><option>Workwear</option><option>Cleaning and hygiene</option><option>Stationery and packaging</option><option>A mix of these</option></select></label>
<label class="f">Product list, sizes, standards and delivery address<textarea name="x" rows="4"></textarea></label>
<div class="f"><button class="btn" type="submit">Prepare my request</button></div>
<p class="out" id="out" role="status"></p>
</form></div></section>
</main>

<footer><div class="wrap"><div><picture><source media="(prefers-color-scheme: dark)" srcset="data:image/png;base64,"><img src="data:image/png;base64," alt="VersaServe Supply" style="height:110px;width:auto;display:block"></picture></div>
<div><h3>VersaServe Supply</h3>A division of VersaServe Industries<br>Registration K2023169707, South Africa</div>
<div><h3>Sections</h3><a href="#services">Services</a> · <a href="#rates">Pricing</a> · <a href="#how">How it works</a></div>
<div style="max-width:320px"><h3>Good to know</h3>Every quotation shows its validity period and payment terms. Prices exclude VAT where applicable.</div>
</div></footer>

<script>
var tabs=[].slice.call(document.querySelectorAll('[role=tab]'));
tabs.forEach(function(t,i){t.addEventListener('click',function(){
tabs.forEach(function(b,j){b.setAttribute('aria-selected',i===j);document.getElementById('p'+j).classList.toggle('on',i===j)})})});
document.getElementById('qf').addEventListener('submit',function(e){
e.preventDefault();var f=e.target,v=function(k){return f.elements[k].value};
var body='Name: '+v('n')+'\nOrganisation: '+v('o')+'\nDelivery by: '+v('d')+'\nItems: '+v('h')+'\nNeed: '+v('t')+'\nDetails: '+v('x');
location.href='mailto:?subject='+encodeURIComponent('Supply quote request')+'&body='+encodeURIComponent(body);
document.getElementById('out').textContent='Your email app should open. If it doesn’t, copy these details and send them to us directly.'});
</script>
</body>
</html>
